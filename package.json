{
    "name": "elemix-template",
    "private": true,
    "version": "0.0.0",
    "license": "MIT",
    "type": "module",
    "imports": {
        "#src/*": "./src/*"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . && pnpm lint:tpl && pnpm typecheck && pnpm lint:analyze",
        "lint:analyze": "ea --dirs src --root .",
        "lint:tpl": "etf --dirs src",
        "lint:fix": "biome check --write . && etf --dirs src --write"
    },
    "dependencies": {
        "@neuralfog/elemix": "0.9.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.3",
        "@neuralfog/elemix-analyzer": "0.9.1",
        "@neuralfog/elemix-template-formatter": "0.9.1",
        "@neuralfog/elemix-vite": "0.9.1",
        "sass": "1.101.0",
        "typescript": "7.0.2",
        "vite": "8.1.4"
    }
}
